{
  "name": "shevartv/mxapi2-dev",
  "description": "Инструменты разработки mxApi: тесты ядра без поднятия MODX",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^8.5"
